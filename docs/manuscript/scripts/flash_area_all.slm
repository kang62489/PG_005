#!/bin/bash
#SBATCH --job-name=flash_area
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=kang.chu@oist.jp
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --nodelist=saion-gpu21
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --time=24:00:00
#SBATCH --output=/work/WickensU/kang/logs/flash_area_%j.out
#SBATCH --error=/work/WickensU/kang/logs/flash_area_%j.err

# Manuscript flash-area histograms (60X / 40X / 10X, GACh3.0) with NO lower blob size limit.
# Detection = the pipeline's threshold + mask cleanup on the GPU (CPU fallback otherwise).
# Independent output under $OUT_ROOT (not results/):
#   flash_tables/{stem}.csv   every flash (~30 MB each, ~5 GB total)
#   value_counts/{stem}.npz   exact float16 value counts = global histogram, rebin to any bin count
#   figures/flash_area_{obj}.png + _bins.csv,  recordings.csv (lo / hi / bg_center / bg_sigma / threshold)
# Resumable: recordings with both a CSV and an NPZ are skipped -> resubmit after a timeout.
# 16G: one float16 stack (~2.5 GB, read without a copy) + masks / labels + the per-objective flash tables at the end.

PROJECT=/home/k/kang-chu/PG_005
PROC_LIST=$PROJECT/data/proc_20260922_000_saion.txt
OUT_ROOT=/work/WickensU/kang/flash_area

export COLUMNS=200
export PYTHONUNBUFFERED=1  # print() lines reach the .out log immediately

$PROJECT/.venv/bin/python $PROJECT/docs/manuscript/scripts/flash_area_all.py \
    --proc_list $PROC_LIST \
    --db $PROJECT/data/rec_data.db \
    --exp_db $PROJECT/data/exp_info.db \
    --out_root $OUT_ROOT
