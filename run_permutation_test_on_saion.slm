#!/bin/bash
#SBATCH --job-name=perm_test
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=kang.chu@oist.jp
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --nodelist=saion-gpu21
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --time=08:00:00
#SBATCH --array=0-102
#SBATCH --output=/work/WickensU/kang/logs/perm_test_%A_%a.out
#SBATCH --error=/work/WickensU/kang/logs/perm_test_%A_%a.err

# Permutation test of the th_flash sizes (docs/permutation_test.md): one GACh3.0 recording of objective $OBJ per
# array task (--task_index = SLURM_ARRAY_TASK_ID), 200 pixel-wise surrogates each (-> $OUT_ROOT/$OBJ/).
# Objective (default 10X) and array range per objective:
#   sbatch run_permutation_test_on_saion.slm                                    (10X: 103 recordings, --array=0-102)
#   sbatch --array=0-13 --export=ALL,OBJ=40X run_permutation_test_on_saion.slm  (40X: 14 recordings)
#   sbatch --array=0-58 --export=ALL,OBJ=60X run_permutation_test_on_saion.slm  (60X: 59 recordings, 1400 frames
#                                                                                -> ~17 % more time and RAM)
# Output: {stem}_th_flash_sizes.npz, {stem}_surrogates.csv (resumable: resubmit a task after a timeout),
# summary.csv (th_small_obj_px = smallest size with p < 0.005, rounded up to 100 px; rebuilt by each finished task).
# Test one task first: sbatch --array=0 run_permutation_test_on_saion.slm
# GPU: ~8 GB (z-stack + masks + one band). 16G RAM: banded detrend peaks at ~9 GB (raw uint16 + float32 detrended),
# surrogates at ~10 GB (float16 z-stack + its pixel-major copy + 2-3 masks of 1.5 GB).
# ~40 s setup + 200 x ~2.9 s locally (RTX 5070 Ti) -> ~10 min per task; 8 h leaves room for a slower
# GPU (a timed-out task resumes from its {stem}_surrogates.csv when resubmitted).
# Create the log folder once before submitting: mkdir -p /work/WickensU/kang/logs

PROJECT=/home/k/kang-chu/PG_005
PROC_LIST=$PROJECT/data/proc_20260922_000_saion.txt
OBJ=${OBJ:-10X}
OUT_ROOT=/work/WickensU/kang/results/permutation/$OBJ

export COLUMNS=200
export PYTHONUNBUFFERED=1  # print() lines reach the .out log immediately

$PROJECT/.venv/bin/python $PROJECT/permutation_test.py \
    --proc_list $PROC_LIST \
    --db $PROJECT/data/rec_data.db \
    --exp_db $PROJECT/data/exp_info.db \
    --obj $OBJ \
    --task_index $SLURM_ARRAY_TASK_ID \
    --out_root $OUT_ROOT
