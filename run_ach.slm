#!/bin/bash
#SBATCH --job-name=ach_domain
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=kang.chu@oist.jp
#SBATCH --partition=compute
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=64
#SBATCH --mem=64G
#SBATCH --time=12:00:00
#SBATCH --output=logs/ach_%j.out
#SBATCH --error=logs/ach_%j.err

mkdir -p logs

export COLUMNS=200

/home/k/kang-chu/PG_005/.venv/bin/python /home/k/kang-chu/PG_005/ach_domain_analysis.py \
    --ana_list /home/k/kang-chu/PG_005/data/ana_20260618_000.txt \
    --db /home/k/kang-chu/PG_005/data/rec_data.db \
    --exp_db /home/k/kang-chu/PG_005/data/exp_info.db

